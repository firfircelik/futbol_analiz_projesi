# Database
DATABASE_URL=sqlite:///./scoutai.db
DATABASE_URL_ASYNC=sqlite+aiosqlite:///./scoutai.db

# Security
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe (development mode - test keys)
STRIPE_API_KEY=sk_test_YOUR_TEST_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Redis (optional for development - will use in-memory fallback if unavailable)
REDIS_URL=redis://localhost:6379/0

# API Settings
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:3001"]

# Environment
ENVIRONMENT=development
DEBUG=True

# Sentry (optional)
SENTRY_DSN=
